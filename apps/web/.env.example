# Postgres (Neon) — pooled endpoint, used by the app for connection pooling
DATABASE_URL=

# Postgres (Neon) — direct endpoint, required for migrations (pooler doesn't support DDL)
DIRECT_URL=

# NextAuth (v5 also reads AUTH_SECRET; set both to the same value)
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bunny CDN (Edge Storage) — video/thumbnail storage
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
# Default is storage.bunnycdn.com; override with a region host (e.g. ny.storage.bunnycdn.com)
BUNNY_STORAGE_HOST=
# Pull zone hostname videos are served from, e.g. screenbolt.b-cdn.net
BUNNY_PULL_ZONE_HOST=

# Google Drive / Dropbox integrations
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Midtrans SNAP billing
# Get keys from https://dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Client-exposed: also prefix with NEXT_PUBLIC_ for browser access
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set to "true" for production, "false" for sandbox
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Cron endpoint protection — generate with: openssl rand -hex 32
CRON_SECRET=
